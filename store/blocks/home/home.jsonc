  //   "props": {
  //     "text": "## Notebook Samsung",
  //     "blockClass": "shelfTitle"
  //   }
  // },
  // "image#title-and-image": {
  //   "title": "Imagem do Notebook",
  //   "props": {
  //     "src": "assets/image/notebook.webp",
  //     "alt": "Notebook",
  //     "maxHeight": 300
  //   }
  // },
  /* Exemplo da primeira aula online */
  "flex-layout.row#section-1": {
    "title": "Infos details",
    "children": [
      "flex-layout.col#container-image",
      "flex-layout.col#container-text"
    ],
    "props": {
      "blockClass": "row--section-1"
    }
  },
  "flex-layout.col#container-image": {
    "title": "Container Image",
    "children": ["image#box-image"],
    "props": {
      "horizontalAlign": "center",
      "verticalAlign": "middle"
    }
  },
  "image#box-image": {
    "title": "Image left",
    "props": {
      "src": "assets/image/flat-device.png",
      "alt": "Notebook",
      "maxHeight": "300px"
    }
  },
  "flex-layout.col#container-text": {
    "title": "Container Text",
    "children": [
      "rich-text#box-text",
      "rich-text#box-description"
    ]
  },

  "rich-text#box-text": {
    "title": "Título da seção",
    "props": {
      "text": "## Notebook Samsung",
      "blockClass": "box-text"
    }
  },
  "rich-text#box-description": {
    "title": "Descrição da seção",
    "props": {
      "text": "O novo Notebook Samsung redefine os limites de desempenho e portabilidade para o seu dia a dia. Equipado com processadores de última geração e uma tela de alta definição com cores vibrantes, ele oferece a velocidade necessária para rodar seus projetos de programação, planilhas complexas e ferramentas de design sem travamentos ou lentidão. \n\n Seu design ultrafino em alumínio premium garante a leveza ideal para carregar na mochila, enquanto a bateria de longa duração mantém você conectado o dia inteiro longe das tomadas. Com um ecossistema inteligente, você sincroniza seus arquivos, fotos e notificações com o smartphone instantaneamente, otimizando sua rotina de estudos ou trabalho. \n\nDesfrute de uma experiência visual imersiva e de um teclado ergonômico retroiluminado, projetado para garantir o máximo de conforto mesmo após longas horas de digitação. O equilíbrio perfeito entre potência, elegância e inovação tecnológica.",
      "blockClass": "box-description"
      // "font": "t-heading-7"
    }
  },

  /* Fim da aula online */

  "list-context.image-list#demo": {
    "children": ["slider-layout#demo-images"],
    "props": {
      "height": 570,
      "preload": true,
      "images": [
        {
          "image": "https://storecomponents.vteximg.com.br/arquivos/Class&Style-desktop.png",
          "mobileImage": "https://storecomponents.vteximg.com.br/arquivos/Class&Style-mobile.png"
        },
        {
          "image": "https://storecomponents.vteximg.com.br/arquivos/banner-decoration.png",
          "mobileImage": "https://storecomponents.vteximg.com.br/arquivos/banner-decoration-mobile.png"
        }
      ]
    }
  },
  "slider-layout#demo-images": {
    "props": {
      "itemsPerPage": {
        "desktop": 1,
        "tablet": 1,
        "phone": 1
      },
      "infinite": true,
      "showNavigationArrows": "desktopOnly",
      "blockClass": "carousel"
    }
  },

  "rich-text#shelf-title": {
    "props": {
      "text": "## Verão 2020",
      "blockClass": "shelfTitle"
    }
  },
  /* Cards dos produtos em slider */
  "flex-layout.row#shelf": {
    "children": ["list-context.product-list#demo1"]
  },
  "list-context.product-list#demo1": {
    "blocks": ["product-summary.shelf"],
    "children": ["slider-layout#demo-products"],
    "props": {
      "orderBy": "OrderByTopSaleDESC"
    }
  },
  "slider-layout#demo-products": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": "shelf"
    }
  },

  "info-card#home": {
    "props": {
      "id": "info-card-home",
      "isFullModeStyle": false,
      "textPosition": "left",
      "imageUrl": "https://storecomponents.vteximg.com.br/arquivos/banner-infocard2.png",
      "headline": "Liquidação",
      "callToActionText": "CONFIRA JÁ",
      "callToActionUrl": "/notebook-samsung/p",
      "blockClass": "info-card-home",
      "textAlignment": "center"
    }
  },

  "rich-text#question": {
    "props": {
      "text": "**Esta é uma loja de exemplo criada usando a plataforma VTEX. Quer saber mais?**\n\n**Entre em contato conosco em**\nwww.vtex.com.br",
      "blockClass": "question"
    }
  },

  "rich-text#link": {
    "props": {
      "text": "\n**Entre em contato conosco em**\nwww.vtex.com.br",
      "blockClass": "link"
    }
  }
}
