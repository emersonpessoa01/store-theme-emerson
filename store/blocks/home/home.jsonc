  /* Exemplo da primeira aula online */
  "flex-layout.row#section-1": {
    "title": "Infos details",
    "children": [
      "flex-layout.col#container-image",
      "flex-layout.col#container-text"
    ],
    "props": {
      "blockClass": "row--section-1"
    }
  },
  "flex-layout.col#container-image": {
    "title": "Container Image",
    "children": ["image#box-image"],
    "props": {
      "horizontalAlign": "center",
      "verticalAlign": "middle"
    }
  },
  "image#box-image": {
    "title": "Image left",
    "props": {
      "src": "assets/image/sofa.png",
      "alt": "Notebook",
      "maxHeight": "300px"
    }
  },
  "flex-layout.col#container-text": {
    "title": "Container Text",
    "children": [
      "rich-text#box-text",
      "rich-text#box-description"
    ]
  },

  "rich-text#box-text": {
    "title": "Título da seção",
    "props": {
      "text": "## Notebook Samsung",
      "blockClass": "box-text"
    }
  },
  "rich-text#box-description": {
    "title": "Descrição da seção",
    "props": {
      "text": "Mussum Ipsum, cacilds vidis litro abertis. Posuere libero varius. Nullam a nisl ut ante blandit hendrerit. Aenean sit amet nisi. Atirei o pau no gatis, per gatis num morreus. Copo furadis é disculpa de bebadis, arcu quam euismod magna.  \n\n Si num tem leite então bota uma pinga aí cumpadi!Diuretics paradis num copo é motivis de denguis. Todo mundo vê os porris que eu tomo, mas ninguém vê os tombis que eu levo! Mais vale um bebadis conhecidiss, que um alcoolatra anonimis. Casamentiss faiz malandris se pirulitá. A ordem dos tratores não altera o pão duris.  \n\nNullam volutpat risus nec leo commodo, ut interdum diam laoreet. Sed non consequat odio. Per aumento de cachacis, eu reclamis. Nec orci ornare consequat. Praesent lacinia ultrices consectetur. Sed non ipsum felis.",
      "blockClass": "box-description"
      // "font": "t-heading-7"
    }
  },

  /* Fim da aula online */

  "list-context.image-list#demo": {
    "children": ["slider-layout#demo-images"],
    "props": {
      "height": 570,
      "preload": true,
      "images": [
        {
          "image": "https://storecomponents.vteximg.com.br/arquivos/Class&Style-desktop.png",
          "mobileImage": "https://storecomponents.vteximg.com.br/arquivos/Class&Style-mobile.png"
        },
        {
          "image": "https://storecomponents.vteximg.com.br/arquivos/banner-decoration.png",
          "mobileImage": "https://storecomponents.vteximg.com.br/arquivos/banner-decoration-mobile.png"
        }
      ]
    }
  },
  "slider-layout#demo-images": {
    "props": {
      "itemsPerPage": {
        "desktop": 1,
        "tablet": 1,
        "phone": 1
      },
      "infinite": true,
      "showNavigationArrows": "desktopOnly",
      "blockClass": "carousel"
    }
  },

  "rich-text#shelf-title": {
    "props": {
      "text": "## Verão 2020",
      "blockClass": "shelfTitle"
    }
  },
  /* Cards dos produtos em slider */
  "flex-layout.row#shelf": {
    "children": ["list-context.product-list#demo1"]
  },
  "list-context.product-list#demo1": {
    "blocks": ["product-summary.shelf"],
    "children": ["slider-layout#demo-products"],
    "props": {
      "orderBy": "OrderByTopSaleDESC"
    }
  },
  "slider-layout#demo-products": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": "shelf"
    }
  },

  "info-card#home": {
    "props": {
      "id": "info-card-home",
      "isFullModeStyle": false,
      "textPosition": "left",
      "imageUrl": "https://storecomponents.vteximg.com.br/arquivos/banner-infocard2.png",
      "headline": "Liquidação",
      "callToActionText": "CONFIRA JÁ",
      "callToActionUrl": "/notebook-samsung/p",
      "blockClass": "info-card-home",
      "textAlignment": "center"
    }
  },

  "rich-text#question": {
    "props": {
      "text": "**Esta é uma loja de exemplo criada usando a plataforma VTEX. Quer saber mais?**\n\n**Entre em contato conosco em**\nwww.vtex.com.br",
      "blockClass": "question"
    }
  },

  "rich-text#link": {
    "props": {
      "text": "\n**Entre em contato conosco em**\nwww.vtex.com.br",
      "blockClass": "link"
    }
  }
}
